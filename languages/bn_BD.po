msgstr "কিস্তির পরিকল্পনা"

msgid "Statement"
msgstr "স্টেটমেন্ট"

msgid "paid"
msgstr "পরিশোধ"

msgid "That ledger row is not here."
msgstr "খাতার এই সারি এখানে নেই।"

msgid "That ledger row is not in this group."
msgstr "খাতার এই সারি এই দলে নেই।"

msgid "Enter an amount."
msgstr "পরিমাণ লিখুন।"

msgid "Choose a date."
msgstr "তারিখ বেছে নিন।"

msgid "The date cannot be more than a day ahead."
msgstr "তারিখ এক দিনের বেশি পরের হতে পারে না।"

msgid "Choose a channel."
msgstr "মাধ্যম বেছে নিন।"

msgid "This is %s more than the balance."
msgstr "এটা বকেয়ার চেয়ে %s বেশি।"

msgid "The payment could not be saved."
msgstr "পরিশোধ সেভ হয়নি।"

msgid "Payment history was not started. Totals did not match: %s"
msgstr "পরিশোধের ইতিহাস শুরু হয়নি। মোট মিলেনি: %s"

msgid "A void needs a reason of at least 5 characters."
msgstr "বাতিল করতে অন্তত ৫ অক্ষরের কারণ লাগে।"

msgid "%1$s voided a payment of %2$s for %3$s"
msgstr "%1$s %3$s-এর %2$s পরিশোধ বাতিল করেছেন"

msgid "%1$s saved an installment plan for %2$s"
msgstr "%1$s %2$s-এর কিস্তির পরিকল্পনা সেভ করেছেন"

msgid "%1$s printed receipt %2$s"
msgstr "%1$s রসিদ %2$s প্রিন্ট করেছেন"

msgid "%1$s shared receipt %2$s"
msgstr "%1$s রসিদ %2$s শেয়ার করেছেন"

msgid "%1$s sent an installment reminder to %2$s"
msgstr "%1$s %2$s-কে কিস্তির কথা মনে করিয়েছেন"

msgid "Receipt %1$s · %2$s"
msgstr "রসিদ %1$s · %2$s"

msgid "Assalamu alaikum %1$s. We received %2$s on %3$s by %4$s. Receipt %5$s. Paid so far %6$s, balance %7$s. JazakAllahu khairan — %8$s"
msgstr "আসসালামু আলাইকুম %1$s। আমরা %3$s তারিখে %4$s-এ %2$s পেয়েছি। রসিদ %5$s। এ পর্যন্ত %6$s, বকেয়া %7$s। জাযাকাল্লাহু খাইরান — %8$s"

msgid "Assalamu alaikum %1$s. A gentle reminder: installment %2$d of %3$s for %4$s was due on %5$s. Balance %6$s. You can pay by bKash/Nagad to %7$s. — %8$s"
msgstr "আসসালামু আলাইকুম %1$s। মনে করিয়ে দিচ্ছি: %4$s-এর %3$s কিস্তি %2$d, তারিখ ছিল %5$s। বকেয়া %6$s। বিকাশ/নগদে %7$s-এ দিতে পারেন। — %8$s"
